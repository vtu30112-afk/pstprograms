class Solution {
    public int pivotIndex(int[] nums) {
        
        int totalSum = 0;
        int leftSum = 0;
        // Calculate total sum
        for (int num : nums) {
            totalSum += num;
        }
        // Find pivot index
        for (int i = 0; i < nums.length; i++) {
            
            totalSum = totalSum - nums[i];
            if (leftSum == totalSum) {
                return i;
            }
            leftSum = leftSum + nums[i];
        }
        return -1;
    }
}
