
import java.util.*;
class Student {
    private int id;
    private String firstName;
    private double cgpa;
    public Student(int id, String firstName, double cgpa) {
        this.id = id;
        this.firstName = firstName;
        this.cgpa = cgpa;
    }
    public int getId() {
        return id;
    }
    public String getFirstName() {
        return firstName;
    }
    public double getCgpa() {
        return cgpa;
    }
}
public class Solution {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        
        // Read the total number of students
        if (!in.hasNextInt()) return;
        int totalStudents = in.nextInt();
        
        List<Student> studentList = new ArrayList<>();
        
        // Loop to extract data and build the student list
        for (int i = 0; i < totalStudents; i++) {
            int id = in.nextInt();
            String firstName = in.next();
            double cgpa = in.nextDouble();
            
            Student st = new Student(id, firstName, cgpa);
            studentList.add(st);
        }
        
        // Sorting using a chained Comparator matching the exact conditions:
        // 1. CGPA in descending order (reversed)
        // 2. First name in alphabetical order
        // 3. ID in ascending order
        studentList.sort(
            Comparator.comparing(Student::getCgpa).reversed()
                      .thenComparing(Student::getFirstName)
                      .thenComparing(Student::getId)
        );
      
        // Print the first name of each student
        for (Student st : studentList) {
            System.out.println(st.getFirstName());
        }
        
        in.close();
    }
}
